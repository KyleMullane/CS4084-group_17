<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10pt"
            android:layout_gravity="top"
            android:textStyle="bold"
            android:gravity="center"
            android:text="Welcome to the Hello World Travel Planner!"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="5pt"
            android:gravity="center"
            android:text="Are you ready to say hello to the world beyond?"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10pt"
            android:gravity="center"
            android:text="Choose an option below to begin planning your next adventure!"/>
        <Button
            android:id="@+id/createTripPageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="sendToCreateTripPage"
            android:text="Create a Trip" />
        <Button
            android:id="@+id/sendToHomePageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="sendToHomePage"
            android:text="View Upcoming Trips" />
        <Button
            android:id="@+id/viewPastTripsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="viewPastTrips"
            android:text="View Past Trips" />
    </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>