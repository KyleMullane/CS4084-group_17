<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ViewTripDetails">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="10pt"
            android:text="These Are Your Trip Details!"/>
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="350dp"
            android:padding="5dp"
            android:textSize="8pt"
            android:id="@+id/tripDetails"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9pt"
            android:layout_gravity="left"
            android:paddingLeft="30dp"
            android:text="Transportation: "
            android:id="@+id/transportationDetails" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="7pt"
            android:layout_gravity="center"
            android:id="@+id/noTransportation" />
        <TableLayout
            android:orientation="vertical"
            android:layout_width="350dp"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:gravity="center"
            android:id="@+id/transportationTable">
        </TableLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9pt"
            android:layout_gravity="left"
            android:paddingLeft="30dp"
            android:text="Accommodation: "
            android:id="@+id/accommodationDetails" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="7pt"
            android:layout_gravity="center"
            android:id="@+id/noAccommodation" />
        <TableLayout
            android:orientation="vertical"
            android:layout_width="350dp"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:gravity="center"
            android:id="@+id/accommodationTable">
        </TableLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9pt"
            android:layout_gravity="left"
            android:paddingLeft="30dp"
            android:text="Activities: "
            android:id="@+id/activityDetails" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="7pt"
            android:layout_gravity="center"
            android:id="@+id/noActivity" />
        <TableLayout
            android:orientation="vertical"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:gravity="center"
            android:id="@+id/activityTable">
        </TableLayout>
        <Button
            android:id="@+id/sendToHomePageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:onClick="sendToHomePage"
            android:text="Back" />
    </LinearLayout>
</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>